# Copy this file to .env and adjust the values (docker compose reads it automatically)

# Database name (created automatically on first start)
DB_NAME=planova
# MySQL root password
DB_PASSWORD=planova_password
# Secret used to sign JWT tokens (use a long random string, 64+ chars). Change it for any real deployment.
JWT_SECRET=change-me-planova-jwt-secret-key-with-more-than-sixty-four-characters-0123456789

# Host ports (change them if they are already in use)
FRONTEND_PORT=5173
BACKEND_PORT=8080
MYSQL_PORT=3306
